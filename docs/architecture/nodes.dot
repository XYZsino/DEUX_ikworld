digraph DEUX {
graph [rankdir=LR, bgcolor="transparent", nodesep=.35, ranksep=.6, pad=.25];
node [fontname="Noto Sans CJK KR", fontsize=12, color="#506582", fontcolor="#18304a", style="filled", fillcolor="#e8f2ff", margin=".24,.12", penwidth=1.4];
edge [color="#547089", arrowsize=.7];
" tf" [label="보정 TF", shape=ellipse, style="filled,dashed", tooltip="/tf · /tf_static / tf2_msgs/TFMessage", id="node-tf"];
"arm" [label="arm_bridge_node", shape=ellipse, style="filled", tooltip="FollowJointTrajectory 연결", id="node-arm"];
"arm_driver" [label="기존 팔 드라이버", shape=ellipse, style="filled,dashed", tooltip="외부 DEUX · 원본 코드 변경 없음", id="node-arm_driver"];
"barcode" [label="barcode_bridge_node", shape=ellipse, style="filled", tooltip="활성 세션에만 판독 결과 연결", id="node-barcode"];
"bt" [label="task_node", shape=ellipse, style="filled", tooltip="메모리 BT · 파지 2회 / 스캔 3회 제한", id="node-bt"];
"camera" [label="외부 ZED", shape=ellipse, style="filled,dashed", tooltip="등록 RGB-D + CameraInfo", id="node-camera"];
"config" [label="installation.yaml", shape=note, style="filled", tooltip="각 runtime/bridge 시작 시 직접 로드 · 토픽 없음", id="node-config"];
"exec" [label="execution_node", shape=ellipse, style="filled", tooltip="검증 · 공통 시작 시각 · 실행 중 감시", id="node-exec"];
"hand" [label="hand_bridge_node", shape=ellipse, style="filled", tooltip="설치별 손 명령 / 측정 피드백 정규화", id="node-hand"];
"hand_driver" [label="원격 손 드라이버", shape=ellipse, style="filled,dashed", tooltip="설치별 feedback topic / 타입 설정", id="node-hand_driver"];
"mapping" [label="hand_mapping.yaml", shape=note, style="filled", tooltip="hand bridge 시작 시 직접 로드", id="node-mapping"];
"operator" [label="태스크 클라이언트", shape=ellipse, style="filled,dashed", tooltip="RunTask goal / result / cancel", id="node-operator"];
"pcfg" [label="인식 파라미터 YAML", shape=note, style="filled", tooltip="클래스 매핑 · 모델 · 보정 프레임 · ROS 파라미터", id="node-pcfg"];
"perception" [label="perception_node", shape=ellipse, style="filled", tooltip="YOLO 1회 · 독립 최신 큐 ICP / 라벨 평면", id="node-perception"];
"planner" [label="motion_planner_node", shape=ellipse, style="filled", tooltip="별도 프로세스 IK / 충돌 / 시간 계획", id="node-planner"];
"reader" [label="바코드 리더", shape=ellipse, style="filled,dashed", tooltip="실제 문자열 입력", id="node-reader"];
"state" [label="state_observation_node", shape=ellipse, style="filled", tooltip="이미지 없는 제어 관측 · 실제 관절 + TF", id="node-state"];
"status" [label="기존 state_node", shape=ellipse, style="filled,dashed", tooltip="자동 제어 소유권 / 모드 확인", id="node-status"];
channel0 [label="/zed/zed_node/rgb/color/rect/image\n/zed/zed_node/depth/depth_registered\nsensor_msgs/Image × 2", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"camera" -> channel0 [color="#2276a5", style=solid];
channel0 -> "perception" [color="#2276a5", style=solid];
channel1 [label="/zed/zed_node/rgb/color/rect/camera_info\n/zed/zed_node/depth/camera_info\nsensor_msgs/CameraInfo × 2", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"camera" -> channel1 [color="#2276a5", style=solid];
channel1 -> "perception" [color="#2276a5", style=solid];
channel2 [label="/task/object_detections\ndeux_task_msgs/ObjectDetectionArray", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"perception" -> channel2 [color="#2276a5", style=solid];
channel2 -> "state" [color="#2276a5", style=solid];
channel3 [label="/task/detections\ndeux_task_msgs/DetectionArray", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"perception" -> channel3 [color="#2276a5", style=solid];
channel4 [label="/task/barcode_target\ndeux_task_msgs/BarcodeTarget", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"perception" -> channel4 [color="#2276a5", style=solid];
channel4 -> "bt" [color="#2276a5", style=solid];
channel4 -> "planner" [color="#2276a5", style=solid];
channel4 -> "exec" [color="#2276a5", style=solid];
channel4 -> "arm" [color="#2276a5", style=solid];
channel4 -> "hand" [color="#2276a5", style=solid];
channel5 [label="/task/state_observation\ndeux_task_msgs/StateObservation", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"state" -> channel5 [color="#2276a5", style=solid];
channel5 -> "bt" [color="#2276a5", style=solid];
channel5 -> "planner" [color="#2276a5", style=solid];
channel5 -> "exec" [color="#2276a5", style=solid];
channel5 -> "arm" [color="#2276a5", style=solid];
channel5 -> "hand" [color="#2276a5", style=solid];
channel6 [label="/state/status\nstd_msgs/String (JSON)", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"status" -> channel6 [color="#2276a5", style=solid];
channel6 -> "bt" [color="#2276a5", style=solid];
channel6 -> "planner" [color="#2276a5", style=solid];
channel6 -> "exec" [color="#2276a5", style=solid];
channel6 -> "arm" [color="#2276a5", style=solid];
channel6 -> "hand" [color="#2276a5", style=solid];
channel7 [label="설정 파일 직접 읽기\nYAML + URDF hash", shape=box, style="rounded,filled", fillcolor="#fff7e7", color="#a36b14", fontsize=10];
"config" -> channel7 [color="#a36b14", style=dashed];
channel7 -> "bt" [color="#a36b14", style=dashed];
channel7 -> "planner" [color="#a36b14", style=dashed];
channel7 -> "exec" [color="#a36b14", style=dashed];
channel7 -> "arm" [color="#a36b14", style=dashed];
channel7 -> "hand" [color="#a36b14", style=dashed];
channel8 [label="/task/perception_request\ndeux_task_msgs/PerceptionRequest", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"bt" -> channel8 [color="#2276a5", style=solid];
channel8 -> "perception" [color="#2276a5", style=solid];
channel9 [label="/task/run\ndeux_task_msgs/RunTask", shape=box, style="rounded,filled", fillcolor="#f4eefe", color="#8054b0", fontsize=10];
"operator" -> channel9 [color="#8054b0", style=solid];
channel9 -> "bt" [color="#8054b0", style=solid];
channel10 [label="/task/plan_motion\ndeux_task_msgs/PlanMotion", shape=box, style="rounded,filled", fillcolor="#f4eefe", color="#8054b0", fontsize=10];
"bt" -> channel10 [color="#8054b0", style=solid];
channel10 -> "planner" [color="#8054b0", style=solid];
channel11 [label="/task/execute_motion\ndeux_task_msgs/ExecuteMotion", shape=box, style="rounded,filled", fillcolor="#f4eefe", color="#8054b0", fontsize=10];
"bt" -> channel11 [color="#8054b0", style=solid];
channel11 -> "exec" [color="#8054b0", style=solid];
channel12 [label="/task/arm_motion\ndeux_task_msgs/BridgeMotion", shape=box, style="rounded,filled", fillcolor="#f4eefe", color="#8054b0", fontsize=10];
"exec" -> channel12 [color="#8054b0", style=solid];
channel12 -> "arm" [color="#8054b0", style=solid];
channel13 [label="/task/hand_motion\ndeux_task_msgs/BridgeMotion", shape=box, style="rounded,filled", fillcolor="#f4eefe", color="#8054b0", fontsize=10];
"exec" -> channel13 [color="#8054b0", style=solid];
channel13 -> "hand" [color="#8054b0", style=solid];
channel14 [label="/arm/deux_arm_controller/follow_joint_trajectory\ncontrol_msgs/FollowJointTrajectory", shape=box, style="rounded,filled", fillcolor="#f4eefe", color="#8054b0", fontsize=10];
"arm" -> channel14 [color="#8054b0", style=solid];
channel14 -> "arm_driver" [color="#8054b0", style=solid];
channel15 [label="/arm/joint_states\nsensor_msgs/JointState", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"arm_driver" -> channel15 [color="#2276a5", style=solid];
channel15 -> "state" [color="#2276a5", style=solid];
channel15 -> "arm" [color="#2276a5", style=solid];
channel16 [label="/task/hand_state\nsensor_msgs/JointState", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"hand" -> channel16 [color="#2276a5", style=solid];
channel16 -> "state" [color="#2276a5", style=solid];
channel17 [label="/hand/left/cmd + /hand/right/cmd\ndeux_hand_msgs/HandCtlMessage", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"hand" -> channel17 [color="#2276a5", style=solid];
channel17 -> "hand_driver" [color="#2276a5", style=solid];
channel18 [label="설정된 left/right feedback_topic\nJointState 또는 HandCtlMessage", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"hand_driver" -> channel18 [color="#2276a5", style=solid];
channel18 -> "hand" [color="#2276a5", style=solid];
channel19 [label="/barcode/raw (설정 가능)\nstd_msgs/String", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"reader" -> channel19 [color="#2276a5", style=solid];
channel19 -> "barcode" [color="#2276a5", style=solid];
channel20 [label="/task/scan_session\ndeux_task_msgs/ScanSession", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"bt" -> channel20 [color="#2276a5", style=solid];
channel20 -> "barcode" [color="#2276a5", style=solid];
channel21 [label="/task/barcode_read\ndeux_task_msgs/BarcodeRead", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"barcode" -> channel21 [color="#2276a5", style=solid];
channel21 -> "bt" [color="#2276a5", style=solid];
channel22 [label="/task/status\ndeux_task_msgs/TaskStatus", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"bt" -> channel22 [color="#2276a5", style=solid];
channel23 [label="/task/execution_record\nstd_msgs/String", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"exec" -> channel23 [color="#2276a5", style=solid];
channel24 [label="매핑 파일 읽기\nYAML", shape=box, style="rounded,filled", fillcolor="#fff7e7", color="#a36b14", fontsize=10];
"mapping" -> channel24 [color="#a36b14", style=dashed];
channel24 -> "hand" [color="#a36b14", style=dashed];
channel25 [label="노드별 ROS 파라미터\nYAML", shape=box, style="rounded,filled", fillcolor="#fff7e7", color="#a36b14", fontsize=10];
"pcfg" -> channel25 [color="#a36b14", style=dashed];
channel25 -> "perception" [color="#a36b14", style=dashed];
channel25 -> "state" [color="#a36b14", style=dashed];
channel26 [label="/tf + /tf_static\ntf2_msgs/TFMessage", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
" tf" -> channel26 [color="#2276a5", style=solid];
channel26 -> "perception" [color="#2276a5", style=solid];
channel26 -> "state" [color="#2276a5", style=solid];
channel27 [label="/task/perception_node/diagnostics\ndiagnostic_msgs/DiagnosticArray", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"perception" -> channel27 [color="#2276a5", style=solid];
channel28 [label="/task/state_observation/diagnostics\ndiagnostic_msgs/DiagnosticArray", shape=box, style="rounded,filled", fillcolor="#edf8fd", color="#2276a5", fontsize=10];
"state" -> channel28 [color="#2276a5", style=solid];
}